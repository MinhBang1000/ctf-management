# Copy this file to .env and fill in real values. .env is never committed.

# --- App ---
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Database ---
DATABASE_URL=postgresql://hslab:changeme@localhost:5432/hslab_ctf

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Added for REQUIRED_FEATURES.md §2 (password reset) ---
PUBLIC_APP_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- One-time Super Admin bootstrap (see backend/app/seed_super_admin.py) ---
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=

# --- Platform credential encryption (Phase 2) ---
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_SECRET_KEY=

# --- Redis (Celery broker/backend + shared rate limiter, Phase 3) ---
REDIS_URL=redis://localhost:6379/0

# Shared Root Me rate limiter — see app/core/rate_limiter.py
ROOTME_RATE_LIMIT_CAPACITY=5
ROOTME_RATE_LIMIT_REFILL_PER_SECOND=1.0
RATE_LIMIT_ACQUIRE_TIMEOUT_SECONDS=30

# Scheduled sync frequency (minutes)
SYNC_INTERVAL_MINUTES=1440

# --- Reminders & Weekly Report scheduling (Phase 4) ---
REMINDER_CHECK_HOUR_UTC=6
WEEKLY_REPORT_DAY_OF_WEEK=1
WEEKLY_REPORT_HOUR_UTC=0

# --- System-default SMTP fallback (used when a Tenant hasn't configured its own) ---
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USERNAME=
DEFAULT_SMTP_PASSWORD=
DEFAULT_SMTP_FROM_ADDRESS=
DEFAULT_SMTP_USE_TLS=true

# --- Backups (Phase 6) ---
# Dedicated, read-only, BYPASSRLS role used ONLY for pg_dump — see OPERATIONS.md.
BACKUP_DATABASE_URL=postgresql://hslab_backup:changeme@localhost:5432/hslab_ctf
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14
BACKUP_HOUR_UTC=3

# --- Alerting (Phase 6) ---
# Consecutive job failures per Tenant before Super Admin gets an email alert.
ALERT_FAILURE_THRESHOLD=3

# --- Cloudflare Tunnel ---
# Leave empty to run a Quick Tunnel (random *.trycloudflare.com URL,
# changes every restart, no account needed).
# Fill in with a token from the Cloudflare Zero Trust dashboard
# (Networks > Tunnels > your tunnel > "Install and run a connector") to
# switch to a Named Tunnel (fixed domain) — no code changes needed.
CLOUDFLARE_TUNNEL_TOKEN=
